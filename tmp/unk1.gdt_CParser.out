static BOOL is_init = FALSE;






void FS_Init(u32 default_dma_no)
{
///+ #if FS_IMPLEMENT ===true
    if(default_dma_no == 0)	OS_TPanic(fsi_assert_fs_format, fsi_assert_is_valid_dma_channel);
